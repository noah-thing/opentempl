{
  "name": "@opentempl/desktop",
  "productName": "OpenTempl",
  "private": true,
  "version": "0.1.0",
  "description": "OpenTempl desktop: the free design tool, offline, in its own window.",
  "main": "main.cjs",
  "author": "Noah",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack:mac": "electron-builder --mac dmg --arm64 --x64",
    "pack:win": "electron-builder --win nsis --x64",
    "pack:linux": "electron-builder --linux AppImage deb --x64"
  },
  "build": {
    "appId": "app.opentempl.desktop",
    "productName": "OpenTempl",
    "files": [
      "main.cjs",
      "preload.cjs",
      "app/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "icon.png",
      "identity": null,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "icon.png",
      "artifactName": "${productName}-${version}-win-x64.${ext}"
    },
    "linux": {
      "icon": "icon.png",
      "category": "Graphics",
      "executableName": "opentempl",
      "maintainer": "Noah",
      "artifactName": "${productName}-${version}-linux-x64.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "opentempl",
        "name": "OpenTempl design",
        "role": "Editor"
      },
      {
        "ext": "tavla",
        "name": "OpenTempl design (old extension)",
        "role": "Editor"
      },
      {
        "ext": "pptx",
        "name": "PowerPoint presentation",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": "pdf",
        "name": "PDF document",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "electronVersion": "45.0.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "^26.18.0"
  }
}
