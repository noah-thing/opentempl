{
  "name": "Tavla",
  "short_name": "Tavla",
  "description": "A free, open source design tool. Your files stay on your machine.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#EDEDF0",
  "theme_color": "#EDEDF0",
  "icons": [
    { "src": "app-icon.png", "sizes": "256x256", "type": "image/png" },
    { "src": "app-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "file_handlers": [{ "action": "./", "accept": { "application/x-tavla": [".tavla"] } }]
}
