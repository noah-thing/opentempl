{
  "name": "opentempl",
  "private": true,
  "version": "0.1.0",
  "description": "A free design app for posters, social posts and slides.",
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @opentempl/editor",
    "dev:site": "npm run dev -w @opentempl/site",
    "build": "npm run build -w @opentempl/site && npm run build -w @opentempl/editor",
    "preview": "npx vite preview --outDir dist --port 4173",
    "typecheck": "npm run typecheck -w @opentempl/editor",
    "test": "npm test -w @opentempl/editor"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
